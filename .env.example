# Copy this file to .env.local for a hosted Supabase deployment.
# Server-side code reads SUPABASE_URL first. NEXT_PUBLIC_SUPABASE_URL remains
# supported as a fallback for existing deployments.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Trusted server-side key. Never expose this as a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Gemini API key from Google AI Studio. Gemini embeddings use 1536 dimensions.
# If omitted, the app uses deterministic local embeddings and fallbacks so
# Docker/offline instances can still ingest, search, and analyse.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# local | gemini. Empty = gemini when GEMINI_API_KEY is present, otherwise local.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=gemini-embedding-001
# Comma-separated model chains, tried in order with automatic failover.
# Leave unset to use the verified defaults in src/lib/ai/gemini.ts.
# GEMINI_ANALYSIS_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_CHAT_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash
# Legacy single-model setting. If set, it is tried FIRST in both chains
# (including analysis). Leave unset unless you mean that.
# GEMINI_CHAT_MODEL=

# Release packs to ingest (folder name prefixes). Data-room files are primary
# evidence, call transcripts secondary; T6* CEO voice notes are never ingested.
VELOXA_RELEASE_DAYS=Day1,Day2,Day3,Day4
# Number of chat personas (chosen by presence in the documents).
VELOXA_PERSONA_COUNT=14
# Set to 1 to log analysis batches and merges to the server console.
# VELOXA_DEBUG_ANALYSIS=
# Local Docker only: path to the release packs mounted into the app container.
VELOXA_DATA_ROOM_PATH=/app/Veloxa_Hackathon_Release_Packs

# Sign-in. Defaults are demo values (ceo / veloxa-brief): change them, and set
# a long random session secret, before deploying anywhere public.
# VELOXA_USERNAME=ceo
# VELOXA_PASSWORD=veloxa-brief
# VELOXA_SESSION_SECRET=
