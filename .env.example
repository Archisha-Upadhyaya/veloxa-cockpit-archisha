# Copy this file to .env.local for a hosted Supabase deployment.
# use the publishable key for browser clients and the secret key only for trusted server-side code.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
DATABASE_URL=postgresql://postgres:[YOUR_DATABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
# Add only for trusted server-side jobs. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Gemini API key from Google AI Studio. Gemini embedding output is configured to 1536 dimensions.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
EMBEDDINGS_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
